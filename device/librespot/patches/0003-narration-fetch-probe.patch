diff --git a/connect/src/context_resolver.rs b/connect/src/context_resolver.rs
index acb0379..b557022 100644
--- a/connect/src/context_resolver.rs
+++ b/connect/src/context_resolver.rs
@@ -419,12 +419,39 @@ async fn probe_narration(session: &Session, ctx: &Context) {
         provider,
         sample_rate
     );
-    match session
+    let url = match session
         .spclient()
         .narration_url(ssml, voice, provider, sample_rate)
         .await
     {
-        Ok(url) => info!("narration probe: got audio url {url}"),
-        Err(why) => warn!("narration probe: {why}"),
+        Ok(url) => url,
+        Err(why) => {
+            warn!("narration probe: {why}");
+            return;
+        }
+    };
+
+    // Fetch it as well, because the url alone does not say what comes back.
+    // Requesting PCM means there is no container to read a channel count or a
+    // rate out of — the bytes are the only description they have — and playing
+    // mono samples as stereo is a half-speed voice, which is the kind of thing
+    // that is obvious afterwards and invisible before.
+    //
+    // The token in the query expires, so this has to happen now rather than
+    // from a url copied out of the log.
+    match session.spclient().request_url(&url).await {
+        Ok(body) => {
+            let bytes = body.len();
+            // At 44100Hz S16: mono is 88200 bytes/s, stereo 176400.
+            info!(
+                "narration probe: fetched {} bytes = {:.2}s if mono, {:.2}s if stereo; \
+                 first 16 bytes {:?}",
+                bytes,
+                bytes as f32 / 88_200.0,
+                bytes as f32 / 176_400.0,
+                &body[..body.len().min(16)]
+            );
+        }
+        Err(why) => warn!("narration probe: fetching the audio failed: {why}"),
     }
 }
