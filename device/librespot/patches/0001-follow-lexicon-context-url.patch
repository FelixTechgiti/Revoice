+    /// Resolve a context whose tracks are served by the lexicon session
+    /// provider, rather than by `/context-resolve/v1`.
+    ///
+    /// Spotify DJ is the case this exists for. `/context-resolve/v1` answers
+    /// for `spotify:playlist:37i9dQZF1EYkqdzj48dyYq` with a single page
+    /// holding no tracks and no `page_url`, and names the real source in the
+    /// context metadata as `lexicon_context_url`. Without following it, DJ is
+    /// simply unplayable: `update_context` rejects the empty context before it
+    /// ever looks at a page url, so there is nothing to follow either.
+    ///
+    /// The URL arrives as `hm://lexicon-session-provider/...`; `get_next_page`
+    /// already establishes that stripping `hm:/` leaves an spclient endpoint.
+    pub async fn get_lexicon_context(&self, hm_url: &str) -> Result<Context, Error> {
+        let endpoint = hm_url.trim_start_matches("hm:/");
+
+        let res = self
+            .request_with_options(&Method::GET, endpoint, None, None, &NO_METRICS_AND_SALT)
+            .await?;
+        let ctx_json = String::from_utf8(res.to_vec())?;
+        if ctx_json.is_empty() {
+            Err(SpClientError::NoData)?
+        }
+
+        // Logged at INFO, not TRACE, and deliberately: this endpoint is not
+        // documented anywhere and the response shape is the whole question.
+        // A device that can reach it is the only place the answer exists.
+        info!("lexicon context response ({} bytes): {ctx_json}", ctx_json.len());
+
+        let ctx = protobuf_json_mapping::parse_from_str::<Context>(&ctx_json);
+        if ctx.is_err() {
+            warn!("failed parsing lexicon context: {ctx_json}")
+        }
+
+        Ok(ctx?)
+    }
