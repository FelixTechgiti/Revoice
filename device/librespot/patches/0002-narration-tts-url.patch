+#[cfg(test)]
+mod narration_tests {
+    use super::*;
+
+    #[test]
+    fn a_tts_request_encodes_the_fields_the_schema_names() {
+        let got = encode_tts_request("<speak/>", 2, 81, 8, 44100);
+        let want = vec![
+            0x12, 8, b'<', b's', b'p', b'e', b'a', b'k', b'/', b'>', // 2: ssml
+            0x18, 2,          // 3: audio_format = PCM
+            0x28, 81,         // 5: tts_voice = 81 (past the known enum, deliberately)
+            0x30, 8,          // 6: tts_provider = SONANTIC_LARGE
+            // 7: sample_rate_hz = 44100. Written out because this is the one
+            // field whose encoding is not obvious by eye, and the first
+            // version of this line was wrong — 0xe4,0xd6,0x02 decodes to
+            // 43876, and the test is what said so.
+            0x38, 0xc4, 0xd8, 0x02,
+        ];
+        assert_eq!(got, want);
+    }
+
+    #[test]
+    fn a_zero_field_is_left_off_the_wire() {
+        // proto3 omits defaults, and a service that distinguishes "unset" from
+        // "zero" would read a written 0 as a deliberate UNSPECIFIED.
+        let got = encode_tts_request("x", 0, 0, 0, 0);
+        assert_eq!(got, vec![0x12, 1, b'x']);
+    }
+}
