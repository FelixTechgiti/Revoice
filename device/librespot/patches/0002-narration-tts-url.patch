+/// `ResolveRequest.AudioFormat.PCM`. Raw samples rather than MP3 because the
+/// device this runs on plays PCM and decodes nothing — asking for a container
+/// would mean shipping a decoder to avoid asking for what the service already
+/// offers.
+const TTS_FORMAT_PCM: i32 = 2;
+
+/// Encode a `TtsRequest` by hand.
+///
+/// Field numbers from spotify/narration/client_tts.proto:
+/// `1 text | 2 ssml`, `3 audio_format`, `4 language`, `5 tts_voice`,
+/// `6 tts_provider`, `7 sample_rate_hz`. `language` is left out: the SSML
+/// carries `xml:lang` itself, and a second opinion about the language is a
+/// second thing that can disagree.
+fn encode_tts_request(
+    ssml: &str,
+    audio_format: i32,
+    voice: i32,
+    provider: i32,
+    sample_rate_hz: i32,
+) -> Vec<u8> {
+    let mut out = Vec::with_capacity(ssml.len() + 32);
+    // field 2, wire type 2 (length-delimited)
+    out.push(2 << 3 | 2);
+    put_varint(&mut out, ssml.len() as u64);
+    out.extend_from_slice(ssml.as_bytes());
+    for (field, value) in [
+        (3u8, audio_format),
+        (5, voice),
+        (6, provider),
+        (7, sample_rate_hz),
+    ] {
+        if value <= 0 {
+            continue; // proto3 does not put a default on the wire
+        }
+        out.push(field << 3); // wire type 0 (varint)
+        put_varint(&mut out, value as u64);
+    }
+    out
+}
+
+fn put_varint(out: &mut Vec<u8>, mut v: u64) {
+    loop {
+        let mut byte = (v & 0x7f) as u8;
+        v >>= 7;
+        if v != 0 {
+            byte |= 0x80;
+        }
+        out.push(byte);
+        if v == 0 {
+            return;
+        }
+    }
+}
