+    /// Turn a DJ narration script into the url of its synthesised audio.
+    ///
+    /// # What this is
+    ///
+    /// Spotify DJ's spoken lines are not audio in the play context. Each
+    /// narrated track carries `narration.intro.ssml` plus the parameters to
+    /// render it — `tts_provider`, `voice`, `sample_rate` — and nothing that
+    /// points at a file. The client synthesises the speech itself, through
+    /// this endpoint.
+    ///
+    /// Wire format and endpoint are from devgianlu/go-librespot, which
+    /// implements this, rather than from probing:
+    /// `POST /client-tts/v1/fulfill`, body a `TtsRequest`, answered **303 with
+    /// an empty body** and the audio url in `Location`.
+    ///
+    /// # Two things that make this longer than it looks
+    ///
+    /// `HttpClient::request` turns every non-2xx into an error before a caller
+    /// can read a header — and the answer here IS a redirect. So this goes
+    /// through `request_fut`, which is the layer below that check, and
+    /// assembles the auth and client-token headers the way
+    /// `request_with_options` does.
+    ///
+    /// The body is encoded by hand rather than through the protocol crate.
+    /// Five fields, all scalar, against a schema that is somebody's extraction
+    /// rather than a published spec — `VOICE81` arrives from the metadata and
+    /// the known enum stops at `VOICE40`, which is exactly the kind of thing
+    /// a generated type would reject and an open proto3 enum carries fine.
+    pub async fn narration_url(
+        &self,
+        ssml: &str,
+        voice: i32,
+        provider: i32,
+        sample_rate_hz: i32,
+    ) -> Result<String, Error> {
+        let body = encode_tts_request(ssml, TTS_FORMAT_PCM, voice, provider, sample_rate_hz);
+
+        let mut url = self.base_url().await?;
+        url.push_str("/client-tts/v1/fulfill");
+
+        let mut request = Request::builder()
+            .method(&Method::POST)
+            .uri(url)
+            .header(CONTENT_LENGTH, body.len())
+            .header(CONTENT_TYPE, "application/x-protobuf")
+            .body(Bytes::from(body))?;
+
+        let token = self.session().login5().auth_token().await?;
+        let headers_mut = request.headers_mut();
+        headers_mut.insert(
+            AUTHORIZATION,
+            HeaderValue::from_str(&format!("{} {}", token.token_type, token.access_token))?,
+        );
+        match self.client_token().await {
+            Ok(client_token) => {
+                let _ = headers_mut.insert(CLIENT_TOKEN, HeaderValue::from_str(&client_token)?);
+            }
+            Err(e) => warn!("narration: no client token: {e} — trying without"),
+        }
+
+        let response = self.session().http_client().request_fut(request)?.await?;
+        let status = response.status();
+        let location = response
+            .headers()
+            .get(LOCATION)
+            .and_then(|v| v.to_str().ok())
+            .map(str::to_string);
+
+        match location {
+            Some(url) if status.is_redirection() => {
+                info!("narration: {} -> audio url ({} bytes)", status, url.len());
+                Ok(url)
+            }
+            _ => {
+                warn!("narration: {status} with no usable Location header");
+                Err(Error::failed_precondition(format!(
+                    "client-tts answered {status} without a Location"
+                )))
+            }
+        }
+    }
+
+    /// Fetch one synthesised narration clip from the url `narration_url` gave.
+    ///
+    /// **Deliberately without the Authorization header the rest of this client
+    /// sends.** The url carries its own signature and points at a CDN, not at
+    /// Spotify's API; no Spotify id, audio key or PlayPlay is involved. Sending
+    /// our bearer token to a host the service nominated would hand it out for
+    /// nothing.
+    ///
+    /// What comes back is **MP3 regardless of the format requested** — measured
+    /// on hardware 2026-09-14, with `audio_format = PCM` in the request and an
+    /// `FF FB` frame header in the answer. The caller decodes by the bytes.
+    pub async fn narration_audio(&self, url: &str) -> Result<Bytes, Error> {
+        let request = Request::builder()
+            .method(&Method::GET)
+            .uri(url)
+            .body(Bytes::new())?;
+
+        let audio = self.session().http_client().request_body(request).await?;
+        if audio.is_empty() {
+            return Err(Error::unavailable("narration audio is empty"));
+        }
+
+        debug!("narration: fetched {} bytes of audio", audio.len());
+        Ok(audio)
+    }
