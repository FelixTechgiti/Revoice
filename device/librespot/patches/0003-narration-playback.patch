@@ -0,0 +1,510 @@
+//! Spotify DJ's spoken lines, played around the track they belong to.
+//!
+//! # What the service gives us, and what it does not
+//!
+//! The narration is not audio in the play context. Each narrated track carries
+//! `narration.intro.ssml` (and sometimes `narration.outro.ssml`) plus the
+//! parameters to render it, and nothing that points at a file: the client
+//! synthesises the speech itself through `/client-tts/v1/fulfill`, which
+//! answers `303` with a signed CDN url. That url is fetched with a plain
+//! unauthenticated GET — it carries its own token, and no Spotify id, audio
+//! key or PlayPlay is involved.
+//!
+//! **What comes back is MP3, not what was asked for.** The request carries
+//! `audio_format = PCM` and the url the service hands back reads
+//! `/v2/generate/sonantic_large/pcm/44100/dj-final-de/…`, so the request was
+//! understood — and the first bytes are `FF FB`, an MPEG-1 Layer III frame
+//! header. Measured on hardware 2026-09-14. Do not trust that field; look at
+//! the bytes.
+//!
+//! Decoding it costs nothing here: symphonia is already a dependency of this
+//! crate with its `mp3` feature enabled, and `SymphoniaDecoder::new` takes any
+//! `MediaSource`, so an in-memory cursor over the clip is the whole of it.
+//! That also inherits its 44100Hz-stereo-only check, which is the same
+//! restriction devgianlu/go-librespot enforces on narration and ships with.
+//!
+//! # Sequential, never mixed
+//!
+//! The official client reports `ms_narration_overlapping = 0`, and this follows
+//! it: the DJ finishes before the music starts. The shape is a port of
+//! devgianlu/go-librespot's `NarratedSource`, which is the only other
+//! implementation of this and had already settled the questions below.
+
+use std::collections::HashMap;
+use std::io::Cursor;
+
+use symphonia::core::probe::Hint;
+
+use crate::decoder::{
+    AudioDecoder, AudioPacket, AudioPacketPosition, DecoderError, DecoderResult, SymphoniaDecoder,
+};
+
+/// Cap on what is pulled into memory for one clip.
+///
+/// Narration runs a couple of seconds and weighs a few hundred kilobytes;
+/// anything wildly larger means something other than a narration clip is on
+/// the other end, and this runs on a device with 256MB of RAM.
+pub const MAX_CLIP_BYTES: usize = 8 << 20;
+
+/// The `tts_provider` name as it appears in the metadata, as the enum value the
+/// service expects.
+///
+/// Anything unrecognised goes as unset rather than as a guess: the service
+/// choosing its own default is a better failure than naming the wrong provider
+/// and getting a voice nobody asked for.
+fn provider_id(name: Option<&str>) -> i32 {
+    match name {
+        Some("CLOUD_TTS") => 1,
+        Some("READSPEAKER") => 2,
+        Some("POLLY") => 3,
+        Some("WELL_SAID") => 4,
+        Some("SONANTIC_FAST") => 6,
+        Some("OPENAI") => 7,
+        Some("SONANTIC_LARGE") => 8,
+        _ => 0,
+    }
+}
+
+/// The loudness a narration clip declares, so it can be matched to the music.
+///
+/// **Absence is reported rather than defaulted, and that is load-bearing.**
+/// Taking a missing value as `0` would mean normalising against 0 LUFS, which
+/// attenuates the clip to nothing — a silent DJ that looks like a working one.
+fn levels(metadata: &HashMap<String, String>, prefix: &str) -> Option<(f64, f64)> {
+    let loudness = metadata.get(&format!("{prefix}.loudness"))?.parse().ok()?;
+    let true_peak = metadata.get(&format!("{prefix}.true_peak"))?.parse().ok()?;
+    Some((loudness, true_peak))
+}
+
+/// One spoken line, as read off a track's metadata: everything needed to ask
+/// the service to render it, and the levels to play it back at.
+#[derive(Clone, Debug, PartialEq)]
+pub struct NarrationClip {
+    pub ssml: String,
+    pub voice: i32,
+    pub provider: i32,
+    pub sample_rate: i32,
+    /// `(loudness, true_peak)` in dB, absent when the metadata does not say.
+    pub levels: Option<(f64, f64)>,
+}
+
+impl NarrationClip {
+    /// Read the clip under one metadata prefix, e.g. `narration.intro`.
+    ///
+    /// Only the script is required. Everything else has a defensible default,
+    /// and a clip that renders in the wrong voice is still a DJ that talks.
+    pub fn from_metadata(metadata: &HashMap<String, String>, prefix: &str) -> Option<Self> {
+        let ssml = metadata.get(&format!("{prefix}.ssml"))?;
+        if ssml.is_empty() {
+            return None;
+        }
+
+        Some(Self {
+            ssml: ssml.clone(),
+            voice: metadata
+                .get(&format!("{prefix}.voice"))
+                .and_then(|v| v.strip_prefix("VOICE"))
+                .and_then(|v| v.parse().ok())
+                .unwrap_or(0),
+            provider: provider_id(
+                metadata
+                    .get(&format!("{prefix}.tts_provider"))
+                    .map(String::as_str),
+            ),
+            sample_rate: metadata
+                .get(&format!("{prefix}.sample_rate"))
+                .and_then(|v| v.parse().ok())
+                .unwrap_or(44100),
+            levels: levels(metadata, prefix),
+        })
+    }
+}
+
+/// The DJ's lines for one track. Either may be absent; a track with neither
+/// produces no `Narration` at all, so the ordinary path stays untouched for
+/// every track that is not part of a DJ context.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Narration {
+    pub intro: Option<NarrationClip>,
+    pub outro: Option<NarrationClip>,
+}
+
+impl Narration {
+    pub fn from_metadata(metadata: &HashMap<String, String>) -> Option<Self> {
+        let intro = NarrationClip::from_metadata(metadata, "narration.intro");
+        let outro = NarrationClip::from_metadata(metadata, "narration.outro");
+        if intro.is_none() && outro.is_none() {
+            return None;
+        }
+        Some(Self { intro, outro })
+    }
+}
+
+/// Decode one narration clip from the bytes fetched off the CDN, at a fixed
+/// gain.
+///
+/// The whole clip is buffered rather than streamed: it runs a couple of
+/// seconds, and the decoder seeks.
+pub fn decode_clip(clip: Vec<u8>, gain: f64) -> DecoderResult<GainDecoder<SymphoniaDecoder>> {
+    let mut hint = Hint::new();
+    // Named rather than probed blind: the service mislabels the format in its
+    // own url (see the module comment), so the extension asserted here is what
+    // the BYTES were measured to be.
+    hint.with_extension("mp3");
+    Ok(GainDecoder::new(
+        SymphoniaDecoder::new(Cursor::new(clip), hint)?,
+        gain,
+    ))
+}
+
+/// A decoder that scales what it passes on.
+///
+/// This exists because the player applies ONE normalisation factor — the
+/// track's — to everything a decoder hands it, and the DJ's clip is mastered
+/// to its own loudness. The caller therefore pre-divides by the track's factor
+/// so that the player's own multiplication lands on the clip's. There is no
+/// other place to put it: `AudioDecoder` is the whole of what the player sees.
+pub struct GainDecoder<D> {
+    inner: D,
+    gain: f64,
+}
+
+impl<D> GainDecoder<D> {
+    pub fn new(inner: D, gain: f64) -> Self {
+        Self { inner, gain }
+    }
+}
+
+impl<D: AudioDecoder> AudioDecoder for GainDecoder<D> {
+    fn seek(&mut self, position_ms: u32) -> Result<u32, DecoderError> {
+        self.inner.seek(position_ms)
+    }
+
+    fn next_packet(&mut self) -> DecoderResult<Option<(AudioPacketPosition, AudioPacket)>> {
+        match self.inner.next_packet()? {
+            Some((position, AudioPacket::Samples(mut samples))) => {
+                if self.gain != 1.0 {
+                    for sample in samples.iter_mut() {
+                        *sample *= self.gain;
+                    }
+                }
+                Ok(Some((position, AudioPacket::Samples(samples))))
+            }
+            // Raw is the passthrough decoder's packet, which narration never
+            // is. Pass it on untouched rather than failing.
+            other => Ok(other),
+        }
+    }
+}
+
+/// A track with the DJ talking around it — an introduction before and a closing
+/// remark after, either of which may be absent.
+///
+/// Position stays the track's throughout, so a listener sees the song as not
+/// yet started while the DJ introduces it. That is what the official client
+/// shows, and it is also the only answer that does not make a seek bar jump
+/// backwards when the music finally begins.
+pub struct NarratedDecoder {
+    parts: Vec<Box<dyn AudioDecoder + Send>>,
+    /// Index of the track itself among the parts.
+    main: usize,
+    cur: usize,
+    /// The track's own position, reported while a clip is playing.
+    main_position_ms: u32,
+}
+
+impl NarratedDecoder {
+    /// Wrap a track with its narration. Either clip may be absent, in which
+    /// case this is the track and nothing else.
+    ///
+    /// `start_position_ms` is where the track itself has already been seeked
+    /// to, and is what an introduction reports while it plays.
+    pub fn new(
+        intro: Option<Box<dyn AudioDecoder + Send>>,
+        main: Box<dyn AudioDecoder + Send>,
+        outro: Option<Box<dyn AudioDecoder + Send>>,
+        start_position_ms: u32,
+    ) -> Self {
+        let mut parts: Vec<Box<dyn AudioDecoder + Send>> = Vec::with_capacity(3);
+        if let Some(intro) = intro {
+            parts.push(intro);
+        }
+        let main_idx = parts.len();
+        parts.push(main);
+        if let Some(outro) = outro {
+            parts.push(outro);
+        }
+        Self {
+            parts,
+            main: main_idx,
+            cur: 0,
+            main_position_ms: start_position_ms,
+        }
+    }
+
+    /// Whether anything is wrapped at all, so a caller can skip this entirely.
+    pub fn is_narrated(&self) -> bool {
+        self.parts.len() > 1
+    }
+}
+
+impl AudioDecoder for NarratedDecoder {
+    /// Seeking abandons an introduction still playing: a listener who scrubs
+    /// wants the music, not the rest of the sentence. A closing remark still
+    /// follows, because it belongs to the end of the track rather than to the
+    /// position within it.
+    fn seek(&mut self, position_ms: u32) -> Result<u32, DecoderError> {
+        if self.cur < self.main {
+            self.cur = self.main;
+        }
+        let reached = self.parts[self.main].seek(position_ms)?;
+        self.main_position_ms = reached;
+        Ok(reached)
+    }
+
+    fn next_packet(&mut self) -> DecoderResult<Option<(AudioPacketPosition, AudioPacket)>> {
+        while self.cur < self.parts.len() {
+            let is_main = self.cur == self.main;
+            match self.parts[self.cur].next_packet() {
+                Ok(Some((mut position, packet))) => {
+                    if is_main {
+                        self.main_position_ms = position.position_ms;
+                    } else {
+                        // A clip's own timeline is not the track's, and the
+                        // track's is what everything downstream reports.
+                        position.position_ms = self.main_position_ms;
+                    }
+                    return Ok(Some((position, packet)));
+                }
+                // This part is done; fall through to the next one rather than
+                // reporting the end of the whole thing.
+                Ok(None) => self.cur += 1,
+                Err(e) => {
+                    // **A failing track is a real error; a failing narration is
+                    // not.** Losing the music because the DJ could not be
+                    // decoded would be a worse device than one that simply
+                    // does not talk.
+                    if is_main {
+                        return Err(e);
+                    }
+                    warn!("narration playback failed, skipping it: {e}");
+                    self.cur += 1;
+                }
+            }
+        }
+        Ok(None)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A decoder that hands out a fixed script of outcomes, so the sequencing
+    /// rules can be driven without any audio.
+    struct Fake {
+        /// One entry per call: `Some(position_ms)` a packet, `None` the end.
+        packets: Vec<Option<u32>>,
+        /// Fail on this call instead of following the script.
+        fail_at: Option<usize>,
+        calls: usize,
+        #[allow(dead_code)]
+        seeked_to: Option<u32>,
+    }
+
+    impl Fake {
+        fn playing(positions: &[u32]) -> Self {
+            Self {
+                packets: positions.iter().map(|p| Some(*p)).collect(),
+                fail_at: None,
+                calls: 0,
+                seeked_to: None,
+            }
+        }
+
+        fn failing() -> Self {
+            Self {
+                packets: vec![],
+                fail_at: Some(0),
+                calls: 0,
+                seeked_to: None,
+            }
+        }
+
+        fn boxed(self) -> Box<dyn AudioDecoder + Send> {
+            Box::new(self)
+        }
+    }
+
+    impl AudioDecoder for Fake {
+        fn seek(&mut self, position_ms: u32) -> Result<u32, DecoderError> {
+            self.seeked_to = Some(position_ms);
+            Ok(position_ms)
+        }
+
+        fn next_packet(&mut self) -> DecoderResult<Option<(AudioPacketPosition, AudioPacket)>> {
+            let call = self.calls;
+            self.calls += 1;
+            if self.fail_at == Some(call) {
+                return Err(DecoderError::SymphoniaDecoder("fake failure".into()));
+            }
+            match self.packets.get(call) {
+                Some(Some(position_ms)) => Ok(Some((
+                    AudioPacketPosition {
+                        position_ms: *position_ms,
+                        skipped: false,
+                    },
+                    AudioPacket::Samples(vec![0.5, 0.5]),
+                ))),
+                _ => Ok(None),
+            }
+        }
+    }
+
+    fn drain(decoder: &mut dyn AudioDecoder) -> Vec<u32> {
+        let mut out = Vec::new();
+        while let Some((position, _)) = decoder.next_packet().expect("decoding failed") {
+            out.push(position.position_ms);
+        }
+        out
+    }
+
+    #[test]
+    fn plays_the_parts_in_order() {
+        let mut d = NarratedDecoder::new(
+            Some(Fake::playing(&[0, 20]).boxed()),
+            Fake::playing(&[0, 10, 20]).boxed(),
+            Some(Fake::playing(&[0]).boxed()),
+            0,
+        );
+        assert!(d.is_narrated());
+        // Six packets: two of intro, three of track, one of outro.
+        assert_eq!(drain(&mut d).len(), 6);
+    }
+
+    #[test]
+    fn a_clip_reports_the_tracks_position_not_its_own() {
+        // The intro runs 0..20ms of its own timeline while the track is to
+        // start at 30000ms. Reporting the clip's timeline would send the
+        // listener's progress bar back to the beginning and then jump.
+        let mut d = NarratedDecoder::new(
+            Some(Fake::playing(&[0, 20]).boxed()),
+            Fake::playing(&[30000, 30010]).boxed(),
+            Some(Fake::playing(&[0, 20]).boxed()),
+            30000,
+        );
+        assert_eq!(drain(&mut d), vec![30000, 30000, 30000, 30010, 30010, 30010]);
+    }
+
+    #[test]
+    fn a_failing_narration_costs_only_itself() {
+        let mut d = NarratedDecoder::new(Some(Fake::failing().boxed()), Fake::playing(&[0, 10]).boxed(), None, 0);
+        assert_eq!(drain(&mut d), vec![0, 10]);
+    }
+
+    #[test]
+    fn a_failing_outro_does_not_fail_the_track() {
+        let mut d = NarratedDecoder::new(None, Fake::playing(&[0, 10]).boxed(), Some(Fake::failing().boxed()), 0);
+        assert_eq!(drain(&mut d), vec![0, 10]);
+    }
+
+    #[test]
+    fn a_failing_track_is_a_real_error() {
+        let mut d = NarratedDecoder::new(None, Fake::failing().boxed(), None, 0);
+        assert!(d.next_packet().is_err());
+    }
+
+    #[test]
+    fn seeking_abandons_an_intro_but_keeps_the_outro() {
+        let mut d = NarratedDecoder::new(
+            Some(Fake::playing(&[0, 20]).boxed()),
+            Fake::playing(&[5000]).boxed(),
+            Some(Fake::playing(&[0]).boxed()),
+            0,
+        );
+        // One packet of intro, then a scrub.
+        assert!(d.next_packet().unwrap().is_some());
+        assert_eq!(d.seek(5000).unwrap(), 5000);
+        // The track's packet and the outro's, and nothing more of the intro.
+        assert_eq!(drain(&mut d), vec![5000, 5000]);
+    }
+
+    #[test]
+    fn without_clips_it_is_the_track_and_nothing_else() {
+        let mut d = NarratedDecoder::new(None, Fake::playing(&[0, 10]).boxed(), None, 0);
+        assert!(!d.is_narrated());
+        assert_eq!(drain(&mut d), vec![0, 10]);
+    }
+
+    #[test]
+    fn gain_scales_the_samples() {
+        let mut d = GainDecoder::new(Fake::playing(&[0]), 0.5);
+        let (_, packet) = d.next_packet().unwrap().unwrap();
+        assert_eq!(packet.samples().unwrap(), &[0.25f64, 0.25]);
+    }
+
+    fn meta(pairs: &[(&str, &str)]) -> HashMap<String, String> {
+        pairs
+            .iter()
+            .map(|(k, v)| (k.to_string(), v.to_string()))
+            .collect()
+    }
+
+    #[test]
+    fn reads_a_clip_off_the_metadata() {
+        let m = meta(&[
+            ("narration.intro.ssml", "<speak>Hallo</speak>"),
+            ("narration.intro.voice", "VOICE7"),
+            ("narration.intro.tts_provider", "SONANTIC_LARGE"),
+            ("narration.intro.sample_rate", "44100"),
+            ("narration.intro.loudness", "-14.5"),
+            ("narration.intro.true_peak", "0.98"),
+        ]);
+        let clip = NarrationClip::from_metadata(&m, "narration.intro").unwrap();
+        assert_eq!(clip.voice, 7);
+        assert_eq!(clip.provider, 8);
+        assert_eq!(clip.sample_rate, 44100);
+        assert_eq!(clip.levels, Some((-14.5, 0.98)));
+    }
+
+    #[test]
+    fn levels_are_absent_rather_than_zero() {
+        // Zero would mean normalising against 0 LUFS, which attenuates the
+        // clip to silence — a DJ that looks like it is working.
+        let m = meta(&[("narration.intro.ssml", "<speak>Hallo</speak>")]);
+        let clip = NarrationClip::from_metadata(&m, "narration.intro").unwrap();
+        assert_eq!(clip.levels, None);
+        // A half-written pair is no pair.
+        let m = meta(&[
+            ("narration.intro.ssml", "<speak>Hallo</speak>"),
+            ("narration.intro.loudness", "-14.5"),
+        ]);
+        assert_eq!(
+            NarrationClip::from_metadata(&m, "narration.intro")
+                .unwrap()
+                .levels,
+            None
+        );
+    }
+
+    #[test]
+    fn an_unknown_provider_goes_unset_rather_than_guessed() {
+        assert_eq!(provider_id(Some("SOMETHING_NEW")), 0);
+        assert_eq!(provider_id(None), 0);
+    }
+
+    #[test]
+    fn a_track_without_narration_produces_none() {
+        assert!(Narration::from_metadata(&meta(&[("some.other.key", "x")])).is_none());
+        // An empty script is not a line to speak.
+        assert!(Narration::from_metadata(&meta(&[("narration.intro.ssml", "")])).is_none());
+    }
+
+    #[test]
+    fn an_outro_alone_is_a_narration() {
+        let n = Narration::from_metadata(&meta(&[("narration.outro.ssml", "<speak>Das war's</speak>")]))
+            .unwrap();
+        assert!(n.intro.is_none());
+        assert!(n.outro.is_some());
+    }
+}
